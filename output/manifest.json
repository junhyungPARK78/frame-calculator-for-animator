{
  "manifest_version": 3,
  "name": "Frame Calculator",
  "version": "0.1.1",
  "description": "Frame/timecode calculator for animation production",
  "action": {
    "default_title": "Frame Calculator"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "tabs"
  ]
}
