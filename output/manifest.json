{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.1.6",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "author": "createzone",
  "homepage_url": "https://github.com/junhyungPARK78/frame-calculator-for-animator",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_appName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ]
}
